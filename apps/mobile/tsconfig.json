{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@proyectointegrador/domain": [
        "../../packages/domain/index.ts"
      ],
      "@proyectointegrador/domain/*": [
        "../../packages/domain/*"
      ],
      "@proyectointegrador/application": [
        "../../packages/application/index.ts"
      ],
      "@proyectointegrador/application/*": [
        "../../packages/application/*"
      ],
      "@proyectointegrador/shared-infra": [
        "../../packages/shared-infra/index.ts"
      ],
      "@proyectointegrador/shared-infra/*": [
        "../../packages/shared-infra/*"
      ],
      "@proyectointegrador/design-tokens": [
        "../../packages/design-tokens/index.ts"
      ],
      "@proyectointegrador/assets": [
        "../../packages/assets/index.ts"
      ],
      "@proyectointegrador/assets/*": [
        "../../packages/assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.d.ts",
    "expo-env.d.ts",
    ".expo/types/**/*.ts"
  ]
}
